# Copy to .env and fill in. Keep .env private (it has the passwords).
NF_VERSION=1.0

# Domain of the store, without http:// (for local tests: localhost:8080 and PS_SSL=0)
PS_DOMAIN=tienda.com
# 1 = HTTPS (real domain), 0 = plain HTTP (local tests)
PS_SSL=1
# Port where PrestaShop listens on the server; with the https profile use PS_BIND=127.0.0.1
PS_PORT=8080
PS_BIND=0.0.0.0

# Database (choose new long random passwords)
DB_NAME=prestashop
DB_USER=natufitness
DB_PASSWD=
MYSQL_ROOT_PASSWORD=
